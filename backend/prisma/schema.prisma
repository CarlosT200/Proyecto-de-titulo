// HabitaSmart - Esquema de base de datos
// Modelo relacional: Condominio -> Torres -> Departamentos -> Residentes
// Residente -> Reservas / Multas / Incidencias / Visitas / Encomiendas

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------
// Enums
// ------------------------------

enum Rol {
  ADMIN
  RESIDENTE
  CONSERJE
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
}

enum EstadoMulta {
  PENDIENTE
  PAGADA
  APELADA
  ANULADA
}

enum EstadoIncidencia {
  REPORTADA
  EN_REVISION
  EN_PROCESO
  RESUELTA
}

enum PrioridadIncidencia {
  BAJA
  MEDIA
  ALTA
}

enum EstadoEncomienda {
  NOTIFICADA
  RETIRADA
  DEVUELTA // no se retiro y se devolvio al remitente o a la empresa de despacho
}

enum TipoComunicado {
  CORTE_AGUA
  CORTE_ELECTRICO
  MANTENCION
  REUNION
  EMERGENCIA
  CAMBIO_HORARIO
  GENERAL
}

enum EstadoVisita {
  VIGENTE
  USADA
  EXPIRADA
  REVOCADA
}

enum TipoQrToken {
  RESIDENTE
  VISITA
}

enum ResultadoAcceso {
  AUTORIZADO
  RECHAZADO
}

enum TipoEmergenciaSos {
  CARABINEROS
  BOMBEROS
  AMBULANCIA
}

enum EstadoAlertaSos {
  ACTIVA
  ATENDIDA
}

// Como se reparte el gasto del mes entre las unidades.
enum MetodoProrrateo {
  PARTES_IGUALES
  ALICUOTA
}

enum MedioPago {
  TRANSFERENCIA
  EFECTIVO
  TARJETA
  CHEQUE
  OTRO
}

// ------------------------------
// Estructura del condominio
// ------------------------------

model Condominio {
  id        String   @id @default(uuid())
  nombre    String
  direccion String?
  comuna    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  torres             Torre[]
  departamentos      Departamento[]
  usuarios           Usuario[]
  espaciosComunes    EspacioComun[]
  multas             Multa[]
  incidencias        Incidencia[]
  encomiendas        Encomienda[]
  comunicados        Comunicado[]
  visitas            Visita[]
  documentos         Documento[]
  accesos            AccesoLog[]
  alertasSos         AlertaSos[]
  auditorias         Auditoria[]
  periodosGastoComun PeriodoGastoComun[]
  cobrosGastoComun   CobroGastoComun[]
  comprobantesPago   ComprobantePago[]

  @@map("condominios")
}

model Torre {
  id           String @id @default(uuid())
  condominioId String
  nombre       String

  condominio    Condominio     @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  departamentos Departamento[]

  createdAt DateTime @default(now())

  @@map("torres")
}

model Departamento {
  id           String   @id @default(uuid())
  condominioId String
  torreId      String?
  numero       String
  // Porcentaje de los gastos comunes que paga la unidad (prorrateo). Opcional: solo se usa si el
  // cobro del mes se reparte "según alícuota".
  alicuota     Decimal? @db.Decimal(7, 4)

  condominio       Condominio        @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  torre            Torre?            @relation(fields: [torreId], references: [id], onDelete: SetNull)
  residentes       Usuario[]
  cobrosGastoComun CobroGastoComun[]

  createdAt DateTime @default(now())

  @@unique([condominioId, torreId, numero])
  @@map("departamentos")
}

// ------------------------------
// Usuarios y autenticación (HU-01, HU-02)
// ------------------------------

model Usuario {
  id                  String    @id @default(uuid())
  condominioId        String
  rol                 Rol
  email               String    @unique
  passwordHash        String
  nombre              String
  apellido            String
  telefono            String?
  departamentoId      String?
  activo              Boolean   @default(true)
  fotoUrl             String?
  // true mientras la persona usa la contraseña temporal que le dio la administracion
  debeCambiarPassword Boolean   @default(false)
  // Cuando se cambio o restablecio la contraseña por ultima vez: las sesiones iniciadas antes ya no valen
  passwordCambiadaEn  DateTime?

  condominio   Condominio    @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  departamento Departamento? @relation(fields: [departamentoId], references: [id], onDelete: SetNull)

  reservas                   Reserva[]
  multas                     Multa[]               @relation("MultaResidente")
  multasRegistradas          Multa[]               @relation("MultaRegistradaPor")
  incidenciasReportadas      Incidencia[]          @relation("IncidenciaReportante")
  incidenciasAsignadas       Incidencia[]          @relation("IncidenciaResponsable")
  incidenciaHistorial        IncidenciaHistorial[]
  encomiendasRecibidas       Encomienda[]          @relation("EncomiendaResidente")
  encomiendasRegistradas     Encomienda[]          @relation("EncomiendaRegistradaPor")
  encomiendasCerradas        Encomienda[]          @relation("EncomiendaCerradaPor")
  comunicadosPublicados      Comunicado[]
  visitasRegistradas         Visita[]
  qrTokens                   QrToken[]
  documentosSubidos          Documento[]
  accesosValidados           AccesoLog[]
  notificaciones             Notificacion[]
  alertasSos                 AlertaSos[]           @relation("AlertaSosResidente")
  alertasAtendidas           AlertaSos[]           @relation("AlertaSosAtendidaPor")
  pushSubscriptions          PushSubscription[]
  auditorias                 Auditoria[]
  periodosGastoComunCreados  PeriodoGastoComun[]   @relation("PeriodoGastoComunCreadoPor")
  pagosGastoComunRegistrados PagoGastoComun[]      @relation("PagoGastoComunRegistradoPor")
  pagosGastoComunAnulados    PagoGastoComun[]      @relation("PagoGastoComunAnuladoPor")
  comprobantesInformados     ComprobantePago[]     @relation("ComprobanteInformadoPor")
  comprobantesRevisados      ComprobantePago[]     @relation("ComprobanteRevisadoPor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([condominioId, rol])
  @@map("usuarios")
}

// ------------------------------
// Espacios comunes y reservas (HU-03, HU-04, HU-05)
// ------------------------------

model EspacioComun {
  id            String  @id @default(uuid())
  condominioId  String
  nombre        String
  descripcion   String?
  capacidad     Int?
  horarioInicio String // HH:mm
  horarioFin    String // HH:mm
  activo        Boolean @default(true)

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  reservas   Reserva[]

  createdAt DateTime @default(now())

  @@map("espacios_comunes")
}

model Reserva {
  id             String        @id @default(uuid())
  espacioComunId String
  usuarioId      String
  fecha          DateTime      @db.Date
  horaInicio     String // HH:mm
  horaFin        String // HH:mm
  estado         EstadoReserva @default(CONFIRMADA)

  espacioComun EspacioComun @relation(fields: [espacioComunId], references: [id], onDelete: Cascade)
  usuario      Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([espacioComunId, fecha])
  @@map("reservas")
}

// ------------------------------
// Multas (HU-06, HU-07)
// ------------------------------

model Multa {
  id              String      @id @default(uuid())
  condominioId    String
  usuarioId       String
  registradaPorId String
  motivo          String
  fecha           DateTime    @db.Date
  monto           Int
  estado          EstadoMulta @default(PENDIENTE)
  observaciones   String?
  // Lo que el residente escribio al apelar y cuando (la administracion resuelve cambiando el estado)
  apelacion       String?
  apeladaEn       DateTime?
  // Decision de la administracion sobre la apelacion: si se acepto (la multa se anula) o se rechazo
  // (sigue pendiente), con la respuesta que ve el residente. Una multa se apela una sola vez.
  apelacionAceptada Boolean?
  respuesta       String?
  respondidaEn    DateTime?

  condominio    Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  usuario       Usuario    @relation("MultaResidente", fields: [usuarioId], references: [id], onDelete: Cascade)
  registradaPor Usuario    @relation("MultaRegistradaPor", fields: [registradaPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([condominioId, usuarioId])
  @@map("multas")
}

// ------------------------------
// Incidencias (HU-08 a HU-11, HU-25)
// ------------------------------

model Incidencia {
  id            String               @id @default(uuid())
  condominioId  String
  usuarioId     String
  titulo        String
  descripcion   String
  ubicacion     String
  fotoUrl       String?
  categoria     String?
  prioridad     PrioridadIncidencia?
  estado        EstadoIncidencia     @default(REPORTADA)
  responsableId String?
  sugerenciaIA  Json?

  condominio  Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  usuario     Usuario    @relation("IncidenciaReportante", fields: [usuarioId], references: [id], onDelete: Cascade)
  responsable Usuario?   @relation("IncidenciaResponsable", fields: [responsableId], references: [id])

  historial IncidenciaHistorial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([condominioId, estado])
  @@map("incidencias")
}

model IncidenciaHistorial {
  id             String  @id @default(uuid())
  incidenciaId   String
  estadoAnterior String?
  estadoNuevo    String
  usuarioId      String
  observacion    String?

  incidencia Incidencia @relation(fields: [incidenciaId], references: [id], onDelete: Cascade)
  usuario    Usuario    @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())

  @@map("incidencia_historial")
}

// ------------------------------
// Encomiendas (HU-12 a HU-14)
// ------------------------------

model Encomienda {
  id                String           @id @default(uuid())
  condominioId      String
  usuarioId         String
  registradaPorId   String
  remitente         String?
  numeroSeguimiento String?
  ubicacion         String? // donde quedo guardada en conserjeria (ej. "Estante B")
  fotoUrl           String? // base64, igual que las fotos de incidencias
  observaciones     String?
  estado            EstadoEncomienda @default(NOTIFICADA)
  fechaRecepcion    DateTime         @default(now())
  fechaRetiro       DateTime?
  retiradaPor       String? // nombre de quien la retiro (puede ser un familiar)
  fechaDevolucion   DateTime?
  motivoDevolucion  String?
  cerradaPorId      String? // quien la entrego o la devolvio

  condominio    Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  usuario       Usuario    @relation("EncomiendaResidente", fields: [usuarioId], references: [id], onDelete: Cascade)
  registradaPor Usuario    @relation("EncomiendaRegistradaPor", fields: [registradaPorId], references: [id])
  cerradaPor    Usuario?   @relation("EncomiendaCerradaPor", fields: [cerradaPorId], references: [id], onDelete: SetNull)

  @@index([condominioId, usuarioId, estado])
  @@index([condominioId, estado, fechaRecepcion])
  @@map("encomiendas")
}

// ------------------------------
// Comunicados (HU-15, HU-16)
// ------------------------------

model Comunicado {
  id           String         @id @default(uuid())
  condominioId String
  autorId      String
  titulo       String
  contenido    String
  tipo         TipoComunicado @default(GENERAL)

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  autor      Usuario    @relation(fields: [autorId], references: [id])

  createdAt DateTime @default(now())

  @@index([condominioId, createdAt])
  @@map("comunicados")
}

// ------------------------------
// Visitas y control de acceso QR (HU-17 a HU-21)
// ------------------------------

model Visita {
  id            String       @id @default(uuid())
  condominioId  String
  residenteId   String
  nombreVisita  String
  fecha         DateTime     @db.Date
  periodoInicio DateTime
  periodoFin    DateTime
  observaciones String?
  soloUnUso     Boolean      @default(false)
  estado        EstadoVisita @default(VIGENTE)

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  residente  Usuario    @relation(fields: [residenteId], references: [id], onDelete: Cascade)
  qrToken    QrToken?

  createdAt DateTime @default(now())

  @@map("visitas")
}

model QrToken {
  id             String      @id @default(uuid())
  tipo           TipoQrToken
  token          String      @unique // codigo opaco de 22 caracteres (o el JWT firmado de los QR anteriores)
  usuarioId      String?
  visitaId       String?     @unique
  expiraEn       DateTime
  usosMaximos    Int?
  usosRealizados Int         @default(0)
  revocado       Boolean     @default(false)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  visita  Visita?  @relation(fields: [visitaId], references: [id], onDelete: Cascade)

  accesos AccesoLog[]

  createdAt DateTime @default(now())

  @@map("qr_tokens")
}

model AccesoLog {
  id            String          @id @default(uuid())
  condominioId  String
  qrTokenId     String?
  validadoPorId String
  resultado     ResultadoAcceso
  motivo        String?

  condominio  Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  qrToken     QrToken?   @relation(fields: [qrTokenId], references: [id])
  validadoPor Usuario    @relation(fields: [validadoPorId], references: [id])

  createdAt DateTime @default(now())

  @@index([condominioId, createdAt])
  @@map("accesos_log")
}

// ------------------------------
// Documentos (HU-22, HU-23)
// ------------------------------

model Documento {
  id           String  @id @default(uuid())
  condominioId String
  subidoPorId  String
  titulo       String
  categoria    String?
  archivoUrl   String

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  subidoPor  Usuario    @relation(fields: [subidoPorId], references: [id])

  createdAt DateTime @default(now())

  @@map("documentos")
}

// ------------------------------
// Notificaciones (soporte HU-13, HU-16, dashboard)
// ------------------------------

model Notificacion {
  id          String  @id @default(uuid())
  usuarioId   String
  tipo        String
  titulo      String
  mensaje     String
  entidadTipo String?
  entidadId   String?
  leida       Boolean @default(false)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([usuarioId, leida])
  @@map("notificaciones")
}

// Suscripcion Web Push de un dispositivo/navegador (un usuario puede tener
// varias: celular + notebook, o dos navegadores distintos). Cuando se crea
// una Notificacion (ver notificaciones.service.ts) se intenta tambien un
// push real a cada suscripcion del usuario, para que le llegue como
// notificacion del sistema operativo aunque no tenga la pestaña abierta --
// critico para la alerta SOS, que antes dependia de que el conserje
// tuviera la app abierta y el polling de 30s la alcanzara a mostrar.
model PushSubscription {
  id        String @id @default(uuid())
  usuarioId String
  endpoint  String @unique
  p256dh    String
  auth      String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([usuarioId])
  @@map("push_subscriptions")
}

// ------------------------------
// Boton SOS de emergencia (residentes)
// ------------------------------

model AlertaSos {
  id            String            @id @default(uuid())
  condominioId  String
  usuarioId     String
  tipo          TipoEmergenciaSos
  estado        EstadoAlertaSos   @default(ACTIVA)
  atendidaPorId String?
  atendidaEn    DateTime?
  observacion   String? // que se hizo al atenderla

  condominio  Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  usuario     Usuario    @relation("AlertaSosResidente", fields: [usuarioId], references: [id], onDelete: Cascade)
  atendidaPor Usuario?   @relation("AlertaSosAtendidaPor", fields: [atendidaPorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([condominioId, createdAt])
  @@index([condominioId, estado])
  @@map("alertas_sos")
}

// ------------------------------
// Trazabilidad de acciones administrativas (RNF-06)
// ------------------------------

// Quien hizo que y cuando. No guarda copia de los datos: solo una descripcion legible, de modo que
// tambien deja rastro de lo que se elimino (comunicados, multas, documentos). Si se borra la
// cuenta de quien actuo, el registro se conserva con usuarioId vacio.
model Auditoria {
  id           String   @id @default(uuid())
  condominioId String
  usuarioId    String?
  accion       String // CREAR | ACTUALIZAR | ELIMINAR | CANCELAR
  entidad      String // Comunicado, Multa, Documento, Usuario...
  entidadId    String?
  descripcion  String
  createdAt    DateTime @default(now())

  condominio Condominio @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([condominioId, createdAt])
  @@map("auditoria")
}

// ------------------------------
// Gastos comunes
// ------------------------------

// El cobro de un mes: el detalle de lo que se gastó (partidas) y cómo se reparte. Al emitirlo se
// crea un cobro por cada unidad. Solo se puede eliminar mientras ninguna unidad tenga pagos.
model PeriodoGastoComun {
  id                     String          @id @default(uuid())
  condominioId           String
  anio                   Int
  mes                    Int // 1 a 12
  fechaVencimiento       DateTime        @db.Date
  metodoProrrateo        MetodoProrrateo
  // Recargo para el fondo común de reserva, en porcentaje sobre el gasto común de cada unidad
  porcentajeFondoReserva Int
  totalGastos            Int // suma de las partidas
  instruccionesPago      String?
  creadoPorId            String

  condominio Condominio          @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  creadoPor  Usuario             @relation("PeriodoGastoComunCreadoPor", fields: [creadoPorId], references: [id])
  partidas   PartidaGastoComun[]
  cobros     CobroGastoComun[]

  createdAt DateTime @default(now())

  @@unique([condominioId, anio, mes])
  @@map("periodos_gasto_comun")
}

model PartidaGastoComun {
  id        String @id @default(uuid())
  periodoId String
  concepto  String
  monto     Int
  orden     Int

  periodo PeriodoGastoComun @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  @@index([periodoId])
  @@map("partidas_gasto_comun")
}

// Lo que debe pagar una unidad en un mes. montoPagado y pagado se actualizan en la misma sentencia
// que registra o anula un pago, para que dos registros simultáneos no puedan pagar de más.
model CobroGastoComun {
  id                String  @id @default(uuid())
  condominioId      String
  periodoId         String
  departamentoId    String
  montoGastoComun   Int
  montoFondoReserva Int
  montoTotal        Int
  montoPagado       Int     @default(0)
  pagado            Boolean @default(false)

  condominio   Condominio        @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  periodo      PeriodoGastoComun @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  departamento Departamento      @relation(fields: [departamentoId], references: [id])
  pagos        PagoGastoComun[]
  comprobantes ComprobantePago[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodoId, departamentoId])
  @@index([condominioId, pagado])
  @@index([departamentoId])
  @@map("cobros_gasto_comun")
}

// Un pago no se borra: si se registró por error se anula con un motivo y queda a la vista.
model PagoGastoComun {
  id              String    @id @default(uuid())
  cobroId         String
  monto           Int
  fechaPago       DateTime  @db.Date
  medio           MedioPago
  referencia      String?
  registradoPorId String
  anuladoEn       DateTime?
  motivoAnulacion String?
  anuladoPorId    String?

  cobro         CobroGastoComun @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  registradoPor Usuario         @relation("PagoGastoComunRegistradoPor", fields: [registradoPorId], references: [id])
  anuladoPor    Usuario?        @relation("PagoGastoComunAnuladoPor", fields: [anuladoPorId], references: [id], onDelete: SetNull)
  comprobante   ComprobantePago?

  createdAt DateTime @default(now())

  @@index([cobroId])
  @@map("pagos_gasto_comun")
}

enum EstadoComprobante {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// Pago que informa el residente con su comprobante (foto o PDF de la transferencia). No suma al
// saldo hasta que la administracion lo aprueba: ahi se crea el PagoGastoComun (pagoId).
model ComprobantePago {
  id             String            @id @default(uuid())
  condominioId   String
  cobroId        String
  informadoPorId String
  monto          Int
  fechaPago      DateTime          @db.Date
  medio          MedioPago
  referencia     String?
  archivo        String // "data:<tipo>;base64,..." (Render no guarda archivos en disco)
  estado         EstadoComprobante @default(PENDIENTE)
  motivoRechazo  String?
  revisadoPorId  String?
  revisadoEn     DateTime?
  pagoId         String?           @unique

  condominio   Condominio      @relation(fields: [condominioId], references: [id], onDelete: Cascade)
  cobro        CobroGastoComun @relation(fields: [cobroId], references: [id], onDelete: Cascade)
  informadoPor Usuario         @relation("ComprobanteInformadoPor", fields: [informadoPorId], references: [id])
  revisadoPor  Usuario?        @relation("ComprobanteRevisadoPor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  pago         PagoGastoComun? @relation(fields: [pagoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([condominioId, estado])
  @@index([cobroId])
  @@map("comprobantes_pago")
}

// Recordatorios automaticos ya enviados (gasto comun por vencer o vencido, encomienda sin retirar).
// La clave es unica: aunque la tarea corra varias veces, cada recordatorio sale una sola vez.
model RecordatorioEnviado {
  id    String @id @default(uuid())
  clave String @unique

  createdAt DateTime @default(now())

  @@map("recordatorios_enviados")
}
