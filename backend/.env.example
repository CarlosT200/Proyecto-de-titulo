PORT=4000
NODE_ENV=development

# Postgres - reemplaza <password> por la contrasena del usuario postgres local
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/habitasmart?schema=public"

JWT_SECRET="reemplaza-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

QR_TOKEN_SECRET="reemplaza-esto-por-otro-secreto-largo-y-aleatorio"

CORS_ORIGIN="http://localhost:5173"

# Base publica de la app (mismo origen que sirve frontend+API) usada para
# armar el link que codifica el QR. En local, dejar sin definir usa
# http://localhost:<PORT> automaticamente.
APP_URL="http://localhost:4000"

# Botones de "entrar con una cuenta de demostracion" en el login. Si no se define, se muestran en
# desarrollo y se ocultan en produccion. Poner "true" solo para una demostracion.
# MOSTRAR_CUENTAS_DEMO="false"

# Web Push (notificaciones del sistema operativo, incluida la alerta SOS,
# aunque la app este cerrada). Generar con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT debe ser un mailto: de contacto real (lo usan los servicios
# de push -- Chrome/Firefox -- si necesitan avisar algo sobre el envio).
VAPID_PUBLIC_KEY="reemplaza-con-la-clave-publica-generada"
VAPID_PRIVATE_KEY="reemplaza-con-la-clave-privada-generada"
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"

# Opcional: clave para que la tarea de GitHub Actions (.github/workflows/recordatorios.yml) pida los
# recordatorios automaticos cada hora aunque el servidor este dormido. Debe ser igual al secreto
# TAREAS_TOKEN del repositorio. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# TAREAS_TOKEN=""
